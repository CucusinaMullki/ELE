#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding = 0, rgba8) uniform readonly image3D srcMip;
layout(binding = 1, rgba8) uniform writeonly image3D dstMip;

void main()
{
    ivec3 dstCoord = ivec3(gl_GlobalInvocationID);
    ivec3 dstSize = imageSize(dstMip);

    if (any(greaterThanEqual(dstCoord, dstSize)))
        return;

    ivec3 srcBase = dstCoord * 2;

    vec4 sum = vec4(0.0);
    float count = 0.0;

    for (int x = 0; x < 2; x++)
    for (int y = 0; y < 2; y++)
    for (int z = 0; z < 2; z++)
    {
        vec4 voxelSample = imageLoad(srcMip, srcBase + ivec3(x, y, z));
        if (voxelSample.a > 0.01)
        {
            sum += voxelSample;
            count += 1.0;
        }
    }

    vec4 result = (count > 0.0) ? vec4(sum.rgb / count, 1.0) : vec4(0.0);
    imageStore(dstMip, dstCoord, result);
}
