#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D shadowMask;

layout(set = 0, binding = 2) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 lightSpaceMatrix;
    mat4 prevViewProj;
    mat4 viewProjNoJitter;
    vec4 camPos;
    vec4 iblParams;
} cam;

struct Light { vec4 position; vec4 color; };
layout(set = 0, binding = 3) uniform LightUBO {
    Light lights[16];
    ivec4 count;
} lightData;

layout(location = 0) rayPayloadEXT float primaryT;
layout(location = 1) rayPayloadEXT float shadowVis;



float traceShadow(vec3 origin, vec3 dir, float tMin, float tMax)
{
    shadowVis = 0.0;
    traceRayEXT(tlas,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF, 0, 0, 1, origin, tMin, dir, tMax, 1);
    return shadowVis;
}

const int SHADOW_SAMPLES = 8;
const float POINT_LIGHT_RADIUS = 0.15;

float ign(vec2 p)
{
    const vec3 m = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(m.z * fract(dot(p, m.xy)));
}

float softPointShadow(vec3 P, vec3 lightPos, float tMin, vec2 px)
{
    vec3 toC = lightPos - P;
    float dC = length(toC);
    vec3 Lc = toC / dC;

    vec3 up = abs(Lc.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, Lc));
    vec3 B = cross(Lc, T);

    float rot = ign(px) * 6.2831853;
    float vis = 0.0;
    for (int i = 0; i < SHADOW_SAMPLES; ++i)
    {
        float r = sqrt((float(i) + 0.5) / float(SHADOW_SAMPLES));
        float a = float(i) * 2.3999632 + rot;
        vec2 d = r * vec2(cos(a), sin(a));
        vec3 target = lightPos + (T * d.x + B * d.y) * POINT_LIGHT_RADIUS;
        vec3 toT = target - P;
        float dT = length(toT);
        vis += traceShadow(P, toT / dT, tMin, dT - tMin);
    }
    return vis / float(SHADOW_SAMPLES);
}

void main()
{
    ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(px) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 wp = inverse(cam.viewProjNoJitter) * vec4(ndc, 0.5, 1.0);
    vec3 origin = cam.camPos.xyz;
    vec3 dir = normalize(wp.xyz / wp.w - origin);

    vec4 result = vec4(1.0);

    primaryT = -1.0;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, 0.01, dir, 10000.0, 0);

    //imageStore(shadowMask, ivec2(gl_LaunchIDEXT.xy),
    //       vec4(primaryT < 0.0 ? 1.0 : 0.0, clamp(primaryT / 50.0, 0.0, 1.0), 0.0, 1.0));
    //return;

    if (primaryT > 0.0)
    {
        vec3 P = origin + dir * primaryT;
        float tMin = 0.02 + primaryT * 0.0005;

        if (lightData.count.x > 0 && lightData.lights[0].position.w < 0.5)
        {
            vec3 L = normalize(-lightData.lights[0].position.xyz);
            result.r = traceShadow(P, L, tMin, 10000.0);
        }

        for (int s = 0; s < 3; ++s)
        {
            int idx = (s == 0) ? lightData.count.y : ((s == 1) ? lightData.count.z : lightData.count.w);
            if (idx < 0 || idx >= lightData.count.x) continue;

            vec3 toLight = lightData.lights[idx].position.xyz - P;
            float d = length(toLight);
            if (d <= tMin) continue;
            result[s + 1] = softPointShadow(P, lightData.lights[idx].position.xyz, tMin, vec2(px));
        }
    }

    imageStore(shadowMask, px, result);
}