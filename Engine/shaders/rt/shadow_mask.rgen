#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D shadowMask;

layout(set = 0, binding = 2) uniform CameraUBO {
    mat4 view; mat4 proj; mat4 lightSpaceMatrix; mat4 prevViewProj; mat4 viewProjNoJitter;
    vec4 camPos; vec4 iblParams;
} cam;

#include "light.glsl"
layout(set = 0, binding = 3) uniform LightUBO {
    Light lights[16];
    ivec4 count;
} lightData;

#include "gbuffer.glsl"

struct HitPayload { float t; vec3 normal; vec2 uv; vec3 albedo; uint objectIndex; uint materialIndex; };
layout(location = 0) rayPayloadEXT HitPayload pl;

const int SHADOW_SAMPLES = 2;
const int RECT_SHADOW_SAMPLES = 4;
const float POINT_LIGHT_RADIUS = 0.15;
const float MIN_RADIANCE = 0.002;

float traceShadow(vec3 origin, vec3 dir, float tMin, float tMax)
{
    pl.t = 1.0;
    traceRayEXT(tlas,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF, 0, 0, 0, origin, tMin, dir, tMax, 0);
    return pl.t < 0.0 ? 1.0 : 0.0;
}

float ign(vec2 p)
{
    const vec3 m = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(m.z * fract(dot(p, m.xy)));
}

float traceTo(vec3 P, vec3 target, float tMin)
{
    vec3 toT = target - P;
    float dT = length(toT);
    return traceShadow(P, toT / dT, tMin, dT - tMin);
}

float softPointShadow(vec3 P, vec3 lightPos, float tMin, vec2 px)
{
    vec3 Lc = normalize(lightPos - P);
    vec3 up = abs(Lc.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, Lc));
    vec3 B = cross(Lc, T);

    float rot = ign(px) * 6.2831853;
    float vis = 0.0;
    for (int i = 0; i < SHADOW_SAMPLES; ++i)
    {
        float r = sqrt((float(i) + 0.5) / float(SHADOW_SAMPLES));
        float a = float(i) * 2.3999632 + rot;
        vec2 d = r * vec2(cos(a), sin(a));
        vis += traceTo(P, lightPos + (T * d.x + B * d.y) * POINT_LIGHT_RADIUS, tMin);
    }
    return vis / float(SHADOW_SAMPLES);
}

float softRectShadow(vec3 P, Light l, float tMin, vec2 px)
{
    const vec3 C  = l.position.xyz;
    const vec3 rx = l.right.xyz;
    const vec3 ry = cross(l.direction.xyz, rx);
    const float hw = l.params.x, hh = l.params.y;

    vec2 shift = vec2(ign(px), ign(px + vec2(17.0, 59.0)));
    float vis = 0.0;
    for (int i = 0; i < RECT_SHADOW_SAMPLES; ++i)
    {
        vec2 u = fract(vec2(0.7548777, 0.5698403) * float(i + 1) + shift) * 2.0 - 1.0;
        vis += traceTo(P, C + rx * (u.x * hw) + ry * (u.y * hh), tMin);
    }
    return vis / float(RECT_SHADOW_SAMPLES);
}

void main()
{
    ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    vec4 result = vec4(1.0);

    vec3 origin, dir, Ps, N;
    float t0;
    if (loadSurface(origin, dir, Ps, N, t0))
    {
        vec3 P = Ps + N * 0.01;
        float tMin = 0.02 + t0 * 0.0005;

        for (int i = 0; i < lightData.count.x; ++i)
        {
            if (lightType(lightData.lights[i]) != LIGHT_DIRECTIONAL) continue;
            vec3 L = normalize(-lightData.lights[i].position.xyz);
            if (dot(N, L) > 0.0)
                result.r = traceShadow(P, L, tMin, 10000.0);
            break;
        }

        for (int s = 0; s < 3; ++s)
        {
            int idx = (s == 0) ? lightData.count.y : ((s == 1) ? lightData.count.z : lightData.count.w);
            if (idx < 0 || idx >= lightData.count.x) continue;
            Light light = lightData.lights[idx];
            const int lt = lightType(light);
            if (lt == LIGHT_DIRECTIONAL) continue;

            vec3 toL = light.position.xyz - P;
            float d2 = dot(toL, toL);
            if (d2 <= tMin * tMin) continue;
            if (light.color.a / d2 < MIN_RADIANCE) continue;

            if (lt == LIGHT_RECT)
            {
                if (light.right.w < 0.5 && dot(P - light.position.xyz, light.direction.xyz) <= 0.0) continue;
                result[s + 1] = softRectShadow(P, light, tMin, vec2(px));
                continue;
            }

            if (dot(N, toL) <= 0.0) continue;

            if (lt == LIGHT_SPOT && dot(-normalize(toL), light.direction.xyz) < light.params.y) continue;

            result[s + 1] = softPointShadow(P, light.position.xyz, tMin, vec2(px));
        }
    }

    imageStore(shadowMask, px, result);
}
