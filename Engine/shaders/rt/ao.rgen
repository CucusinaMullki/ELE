#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "rt_common.glsl"
#include "gbuffer.glsl"

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D aoOutput;

const int   AO_RAYS   = 6;
const float AO_RADIUS = 1.0;

float ign(vec2 p)
{
    const vec3 m = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(m.z * fract(dot(p, m.xy)));
}

float computeAO(vec3 P, vec3 N, vec2 px)
{
    vec3 up = abs(N.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    float rot = ign(px) * 6.2831853;

    float vis = 0.0;
    for (int i = 0; i < AO_RAYS; ++i)
    {
        float r = sqrt((float(i) + 0.5) / float(AO_RAYS));
        float a = float(i) * 2.3999632 + rot;
        vec3 d = T * (r * cos(a)) + B * (r * sin(a)) + N * sqrt(max(0.0, 1.0 - r * r));
        if (!occluded(P + N * 0.02, d, AO_RADIUS)) vis += 1.0;
    }
    return vis / float(AO_RAYS);
}

void main()
{
    ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    vec3 origin, dir, P, N;
    float t0;
    if (!loadSurface(origin, dir, P, N, t0))
    {
        imageStore(aoOutput, px, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    float ao = computeAO(P, N, vec2(px));

    float q = floor(clamp(t0 / 128.0, 0.0, 1.0) * 65535.0 + 0.5);
    float hi = floor(q / 256.0);
    float lo = q - hi * 256.0;
    imageStore(aoOutput, px, vec4(ao, hi / 255.0, lo / 255.0, 1.0));
}
