#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "rt_common.glsl"

layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D gbufOut;

void main()
{
    ivec2 px = ivec2(gl_LaunchIDEXT.xy);
    vec2 uv = (vec2(px) + 0.5) / vec2(gl_LaunchSizeEXT.xy);
    vec4 wp = inverse(cam.viewProjNoJitter) * vec4(uv * 2.0 - 1.0, 0.5, 1.0);
    vec3 origin = cam.camPos.xyz;
    vec3 dir = normalize(wp.xyz / wp.w - origin);

    pl.t = -1.0;
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, origin, 0.01, dir, 10000.0, 0);

    imageStore(gbufOut, px, pl.t > 0.0 ? vec4(pl.normal, pl.t) : vec4(0.0, 0.0, 1.0, -1.0));
}
